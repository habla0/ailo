rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /businesses/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 100
        // Optional opening hours: a summary string plus a map of days
        && (!('hours' in request.resource.data)
          || (request.resource.data.hours is string && request.resource.data.hours.size() <= 300))
        && (!('openingHours' in request.resource.data) || request.resource.data.openingHours is map)
        // Optional Meet the Owners intro
        && (!('ownersIntro' in request.resource.data)
          || (request.resource.data.ownersIntro is string
            && request.resource.data.ownersIntro.size() <= 2000))
        // Optional photos: shrunk JPEG data URLs (see src/photo.js).
        && (!('businessPhoto' in request.resource.data)
          || (request.resource.data.businessPhoto is string
            && request.resource.data.businessPhoto.size() <= 450000))
        && (!('ownersPhoto' in request.resource.data)
          || (request.resource.data.ownersPhoto is string
            && request.resource.data.ownersPhoto.size() <= 450000));
      // Submissions are final: edits and deletions are made in the Firebase console only.
      allow update, delete: if false;
    }
  }
}
